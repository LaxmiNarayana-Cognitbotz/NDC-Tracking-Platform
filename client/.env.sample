# Vite Base Path (e.g. for production use /ndc/v2/)
#VITE_BASE_PATH=/ndc/v2/

# Go-Live Baseline Settings
VITE_USE_GO_LIVE_BASELINE=true
VITE_GO_LIVE_DATE=2026-08-07

# Enhancement Features Flag
# Set to 'false' to hide all enhancement tabs (Credentials, Scheduler, Email Config, SharePoint Docs, Logs) and show only Users & Access
VITE_ENHANCEMENT_FEATURES=true
