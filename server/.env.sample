# Database
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
SSL_MODE=require

# JWT Auth
JWT_SECRET=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=
RESET_PASSWORD_EXPIRE_MINUTES=

# Database Encryption (AES-256 with PBKDF2 Salting)
ENCRYPTION_KEY=
ENCRYPTION_SALT=

# File Uploads
UPLOAD_DIR=uploads

# SMTP - Local Dev (Gmail/Outlook)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# SMTP - Production Relay (Adani VM / Port 25)
# SMTP_HOST=smtp.adani.com
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASSWORD=

# SharePoint Credentials
SHAREPOINT_TENANT_ID=
SHAREPOINT_SITE_URL=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TARGET_FOLDER=
SHAREPOINT_REPORTS_SUBFOLDER=

# SharePoint Proxy & SSL
SHAREPOINT_SSL_VERIFY=true
PROXY_ENABLED=false
PROXY_URL=
PROXY_INSECURE_SSL=false

# Azure SSO
SSO_ENABLED=False
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=

# Oracle & DMS URLs
ORACLE_URL=
CONTENT_SERVER_URL=

# Browser Automation
HEADLESS=true
START_MAXIMIZED=true